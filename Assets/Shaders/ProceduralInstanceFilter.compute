#ifdef PROCESS_ALIGN_GROUND_SURFACE_NORMAL
void GetSnapGroundHeightNormal(in float2 position2D, out float height, out float3 normalWS)
#else
void GetSnapGroundHeightNormal(in float2 position2D, out float height)
#endif
{
	position2D.x = clamp(position2D.x, _GroundMinMax.x, _GroundMinMax.z);
	position2D.y = clamp(position2D.y, _GroundMinMax.x, _GroundMinMax.z);

	float2 destUV = float2(
		(position2D.x - _GroundMinMax.x) / 
		(_GroundMinMax.z - _GroundMinMax.x),
		(position2D.y - _GroundMinMax.y) / 
		(_GroundMinMax.w - _GroundMinMax.y));

	float4 groundHeightNormal = _GroundHeightNormalMap.SampleLevel(
		sampler_GroundHeightNormalMap, destUV, 0);
	
	height = _HeightMinMax.x + groundHeightNormal.a *
		(_HeightMinMax.y - _HeightMinMax.x);

#ifdef PROCESS_ALIGN_GROUND_SURFACE_NORMAL
	normalWS = groundHeightNormal.xyz * 2.0 - 1.0;
#endif //PROCESS_ALIGN_GROUND_SURFACE_NORMAL
}

void GetDestBrushInfo(in half4 weightColor, out half brushIndex,
	out half weightRatio)
{
	brushIndex = 0;
	weightRatio = weightColor.r;
	if (weightRatio < weightColor.g)
	{
		weightRatio = weightColor.g;
		brushIndex = 1;
	}
	if (weightRatio < weightColor.b)
	{
		weightRatio = weightColor.b;
		brushIndex = 2;
	}
	if (weightRatio < weightColor.a)
	{
		weightRatio = weightColor.a;
		brushIndex = 3;
	}
}

float2 GetRandomOffest2D(in float2 point2D)
{
	float3 point3D = frac(float3(point2D.xyx) * s_cRandomVector);
	point3D += dot(point3D, point3D.yzx + 33.33);
	return frac((point3D.xx + point3D.yz) * point3D.zy);
}

float2 GetInstanceTransform(in uint instanceOffest, out float2 nonOffestTransform, out float2 instanceRandomOffest)
{
	uint destCellIndex = _VisibleCellIndexBuffer[instanceOffest / _CellInstanceCount];

	uint destCellColumnIndex = destCellIndex % _CellColumnCount;
	uint destCellRowIndex = destCellIndex / _CellColumnCount;

	float2 groundOrigion = float2(
		_GroundMinMax.x + destCellColumnIndex * _CellSize.x,
		_GroundMinMax.y + destCellRowIndex * _CellSize.y);

	uint offestInstanceIndex = instanceOffest % _CellInstanceCount;

	uint2 instanceIndex = uint2(
		offestInstanceIndex % _CellInstanceColumnCount,
		offestInstanceIndex / _CellInstanceColumnCount);

	nonOffestTransform = float2(
		groundOrigion.x + instanceIndex.x * _InstanceSpacing.x,
		groundOrigion.y + instanceIndex.y * _InstanceSpacing.y);
	
	instanceRandomOffest = GetRandomOffest2D(nonOffestTransform) * 2.0 - 1.0;

	return nonOffestTransform + instanceRandomOffest * _JitterStrength;
}

void ApplyClumpTransform(in float2 nonOffestTransform, inout float2 transform)
{
	float2 clumpUV = nonOffestTransform * _ClumpScale;

	//Retrieve clump data for this blade from voronoi texture
	//This includes the clump blade parameter id, and the Center of this clump
	//in texture space
	half3 clumpData = _VoronoiRT.SampleLevel(sampler_VoronoiRT,
		clumpUV, 0).xyz;

	//Compute the clump Center in world space by finding its offsetted position 
	//in texture space and -dividing- that by the voronoi tiling
	float2 clumpCenter = (clumpData.yz + floor(clumpUV)) / _ClumpScale;	
	
	transform = lerp(transform, clumpCenter, _ClumpParams[round(clumpData.x)].x);
}
*/

float2 GetRandomOffest2D(in float2 point2D)
{
	float3 point3D = frac(float3(point2D.xyx) * s_cRandomVector);
	point3D += dot(point3D, point3D.yzx + 33.33);
	return frac((point3D.xx + point3D.yz) * point3D.zy);
}

float3 GetInstanceTransform(in uint instanceOffest)
{
	uint destCellIndex = _VisibleCellIndexBuffer[instanceOffest / _CellInstanceCount];

	uint destCellColumnIndex = destCellIndex % _CellColumnCount;
	uint destCellRowIndex = destCellIndex / _CellColumnCount;

	float2 worldOrigion = float2(
		_WorldMinMax.x + destCellColumnIndex * _CellSize.x,
		_WorldMinMax.y + destCellRowIndex * _CellSize.y);

	uint offestInstanceIndex = instanceOffest % _CellInstanceCount;

	uint2 instanceIndex = uint2(
		offestInstanceIndex % _CellInstanceColumnCount,
		offestInstanceIndex / _CellInstanceColumnCount);

	float2 nonOffestTransform = float2(
		worldOrigion.x + instanceIndex.x * _InstanceSpacing.x,
		worldOrigion.y + instanceIndex.y * _InstanceSpacing.y);

	float2 randomOffest2D = GetRandomOffest2D(nonOffestTransform);

	float2 instanceRandomOffest = randomOffest2D * 2.0 - 1.0;

	float2 resultPosition = nonOffestTransform + instanceRandomOffest * _JitterStrength;

	// scale to 0~2π (radians)
	return float3(resultPosition.x, resultPosition.y, instanceRandomOffest.x * 6.2831853);
}

